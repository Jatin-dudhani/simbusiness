# ==============================================================================
# SimBusiness — Environment Configuration & 3rd Party API Keys
# Copy this file to .env.local to customize your deployment.
# ==============================================================================

# Public Site Configuration
NEXT_PUBLIC_SITE_NAME="SimBusiness"
NEXT_PUBLIC_SITE_TITLE="SimBusiness — Dropshipping Business Simulation"
NEXT_PUBLIC_SITE_DESCRIPTION="A modern, minimalist e-commerce and dropshipping simulation platform."
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Contact & Support Details (Customizable)
NEXT_PUBLIC_CONTACT_EMAIL="jatindudhani07@gmail.com"
NEXT_PUBLIC_ADMIN_EMAIL="jatindudhani07@gmail.com"
NEXT_PUBLIC_CONTACT_PHONE="+1 (800) 555-0199"
NEXT_PUBLIC_CONTACT_ADDRESS="100 Commerce Boulevard, Suite 400, San Francisco, CA"

# External Product Catalog API (Defaults to FakeStoreAPI with built-in resilient offline fallback)
NEXT_PUBLIC_API_URL="https://fakestoreapi.com"
NEXT_PUBLIC_API_TIMEOUT_MS="8000"

# Business Simulation Defaults
NEXT_PUBLIC_DEFAULT_CURRENCY="USD"
NEXT_PUBLIC_DEFAULT_TAX_RATE="7.5"
NEXT_PUBLIC_DEFAULT_SHIPPING_FEE="4.99"
NEXT_PUBLIC_DEFAULT_MARGIN="35"
NEXT_PUBLIC_INITIAL_INVENTORY="25"
NEXT_PUBLIC_INITIAL_BUDGET="250"

# ------------------------------------------------------------------------------
# Optional 3rd Party API Keys (For Live Production Services)
# If left blank, SimBusiness seamlessly executes in simulated high-fidelity mode.
# ------------------------------------------------------------------------------

# Stripe: For simulated or live credit card / checkout transactions
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Currency Exchange Rates API (e.g., OpenExchangeRates / Fixer.io)
NEXT_PUBLIC_EXCHANGE_RATE_API_KEY=""

# Supplier API Key (e.g., AliExpress Open Platform, Printful, CJ Dropshipping)
NEXT_PUBLIC_SUPPLIER_API_KEY=""

# AI Engine Key (Gemini API or OpenAI API for generating AI dropshipping niche insights)
NEXT_PUBLIC_AI_API_KEY=""
